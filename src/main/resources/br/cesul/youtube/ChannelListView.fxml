<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Button?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="br.cesul.youtube.view.ChannelListView"
           fx:id="rootPane"
           style="-fx-background-color: #fff;"
           prefWidth="500" prefHeight="720">

    <VBox spacing="20" alignment="TOP_CENTER" style="-fx-padding: 40;">

        <!-- Título -->
        <Label text="Canais"
               style="-fx-font-size: 36px;
                      -fx-text-fill: #333333;
                      -fx-font-weight: bold;"/>

        <!-- Lista de canais -->
        <ListView fx:id="channelList" prefHeight="600" prefWidth="900"
                  style="
                      -fx-background-color: white;
                      -fx-control-inner-background: white;
                      -fx-font-size: 20px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #333333;
                      -fx-border-color: #cccccc;
                      -fx-border-radius: 8;
                      -fx-background-radius: 8;
                      -fx-padding: 5;
                  "/>

        <!-- Botão criar canal -->
        <Button fx:id="createChannelButton" text="Criar Novo Canal"
                style="
                    -fx-background-color: red;
                    -fx-text-fill: white;
                    -fx-font-size: 18px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 50;
                    -fx-padding: 10 40 10 40;
                    -fx-cursor: hand;
                " />

    </VBox>

</StackPane>
