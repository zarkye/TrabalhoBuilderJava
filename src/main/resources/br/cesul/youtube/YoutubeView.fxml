<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.cesul.youtube.view.ChannelView"
            fx:id="rootPane"
            prefWidth="1280" prefHeight="720"
            style="-fx-background-color: #fff; -fx-padding: 10 30 10 30;">

   <VBox alignment="TOP_CENTER" spacing="0"
         AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
         AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

      <!-- Imagem de fundo do canal -->
      <StackPane prefHeight="250">
         <ImageView fx:id="channelBackgroundImage"
                    fitWidth="1250" fitHeight="250"
                    preserveRatio="false"
                    style="-fx-opacity: 1;">
            <clip>
               <Rectangle width="1250" height="250" arcWidth="50" arcHeight="50"/>
            </clip>
         </ImageView>
      </StackPane>

      <!-- Informações do canal -->
      <HBox alignment="CENTER_LEFT" spacing="20"
            style="-fx-padding: 30; -fx-background-color: #fff;">

         <ImageView fx:id="channelImage"
                    fitWidth="100" fitHeight="100"
                    style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 0);
                           -fx-background-radius: 50%; -fx-border-radius: 50%;">
            <clip>
               <Circle centerX="50" centerY="50" radius="50" />
            </clip>
         </ImageView>

         <VBox spacing="5">
            <Label fx:id="channelName"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: black;" />
            <Label fx:id="subscribersLabel"
                   style="-fx-font-size: 16px; -fx-text-fill: #333;" />
         </VBox>

         <Region HBox.hgrow="ALWAYS"/>

         <Button fx:id="subscribeButton" text="INSCREVER-SE"
                 style="-fx-background-color: red;
                        -fx-text-fill: white;
                        -fx-font-size: 16px;
                        -fx-font-weight: bold;
                        -fx-background-radius: 50;
                        -fx-padding: 10 30 10 30;
                        -fx-cursor: hand;"/>
      </HBox>
   </VBox>

   <!-- Botão voltar fixo -->
   <Button fx:id="backButton" text="← Voltar"
           AnchorPane.bottomAnchor="20"
           AnchorPane.leftAnchor="20"
           style="
                  -fx-background-color: rgba(0,0,0,0.4);
                  -fx-text-fill: white;
                  -fx-font-size: 14px;
                  -fx-font-weight: bold;
                  -fx-background-radius: 20;
                  -fx-padding: 6 20 6 20;
                  -fx-cursor: hand;
                  -fx-border-color: rgba(255,255,255,0.6);
                  -fx-border-width: 1;
                  -fx-border-radius: 20;
              " />
</AnchorPane>

