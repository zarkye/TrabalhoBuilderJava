<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.input.MouseEvent?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.cesul.lanchebuilder.view.LancheView">

   <children>
      <BorderPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #f0f2f5;">
         <top>
            <HBox spacing="30.0" style="-fx-background-color: #3f51b5;">
               <padding>
                  <Insets top="20" right="20" bottom="20" left="20"/>
               </padding>
               <VBox spacing="10"
                     style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);">
                  <padding>
                     <Insets top="15" right="15" bottom="15" left="15"/>
                  </padding>
                  <children>
                     <Label text="Tipo do Pão" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3f51b5;" />
                     <ComboBox onMouseEntered="#onHover" onMouseExited="#onExit" fx:id="paoBox" prefWidth="180" style="-fx-background-radius: 8;"/>
                     <Label text="Ponto da Carne" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3f51b5;" />
                     <ComboBox onMouseEntered="#onHover" onMouseExited="#onExit" fx:id="carneBox" prefWidth="180" style="-fx-background-radius: 8;"/>
                  </children>
               </VBox>
               <VBox spacing="10"
                     style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);">
                  <padding>
                     <Insets top="15" right="15" bottom="15" left="15"/>
                  </padding>
                  <children>
                     <Label text="Tomate?" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3f51b5;" />
                     <ComboBox onMouseEntered="#onHover" onMouseExited="#onExit" fx:id="tomateBox" prefWidth="150" style="-fx-background-radius: 8;"/>
                     <Label text="Alface?" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3f51b5;" />
                     <ComboBox onMouseEntered="#onHover" onMouseExited="#onExit" fx:id="alfaceBox" prefWidth="150" style="-fx-background-radius: 8;"/>
                  </children>
               </VBox>
               <VBox spacing="15"
                     style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);">
                  <padding>
                     <Insets top="15" right="15" bottom="15" left="15"/>
                  </padding>
                  <children>
                     <Button fx:id="pedidoButton" text="Fazer Pedido" prefHeight="35" prefWidth="150"
                             style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;"
                             onMouseEntered="#onHover" onMouseExited="#onExit"/>
                     <Label fx:id="pedidoCusto" text="Valor do Pedido: R$0,00" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #3f51b5;" />
                  </children>
               </VBox>

            </HBox>
         </top>
         <center>
            <TableView fx:id="lancheTable" prefHeight="500" prefWidth="900"
                       style="-fx-background-color: white;
                                  -fx-background-radius: 12;
                                  -fx-border-radius: 12;
                                  -fx-border-color: #d1d9e6;
                                  -fx-border-width: 1;
                                  -fx-selection-bar: #bbdefb;
                                  -fx-selection-bar-non-focused: #e3f2fd;
                                  -fx-table-cell-border-color: transparent;
                                  -fx-table-header-background: #3f51b5;
                                  -fx-table-header-border-color: #3f51b5;
                                  -fx-control-inner-background: white;
                                  -fx-control-inner-background-alt: #f9f9f9;">
               <columns>
                  <TableColumn fx:id="pedidoCol" prefWidth="300" text="Pedido" style="-fx-alignment: CENTER;" />
                  <TableColumn fx:id="valorCol" prefWidth="200" text="Valor" style="-fx-alignment: CENTER;" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
